nextflow_workflow {

    name "Test Subworkflow BAM_VARIANTCALLING_INTERVALS"
    script "../main.nf"
    config "./nextflow.config"
    workflow "BAM_VARIANTCALLING_INTERVALS"

    tag "subworkflows"
    tag "subworkflows_UMCUGenetics"
    tag "subworkflows/bam_variantcalling_intervals"
    tag "local"
    tag "gatk4"
    tag "gatk4/haplotypecaller"
    tag "gatk4/genotypegvcfs"
    tag "subworkflows/../../modules/nf-core/gatk4/haplotypecaller"
    tag "subworkflows/../../modules/nf-core/gatk4/genotypegvcfs"


    setup{
        nfcoreInitialise("${launchDir}/library/")
        nfcoreInstall(
            "${launchDir}/library/",
            [
                "gatk4/haplotypecaller",
                "gatk4/genotypegvcfs"
            ]
        )
        nfcoreLink("${launchDir}/library/", "${baseDir}/modules/")
    }


    test("Validate BAM_VARIANTCALLING_INTERVALS subworkflow - bam") {
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of( [
                    [ id:'sample1' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam",
                        checkIfExists: true)
                ])
                input[1] = Channel.of( [
                    [ id:'sample1' ], // meta map
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai",
                        checkIfExists: true)
                ])
                input[2] = Channel.of([[id: "genome"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.fasta", checkIfExists: true)]).first()
                input[3] = Channel.of([[id: "genome"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.fasta.fai", checkIfExists: true)]).first()
                input[4] = Channel.of([[id: "genome"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/genome.dict", checkIfExists: true)]).first()
                input[5] = Channel.of([[id: "intervals"],
                    file(params.subworkflows_umcu_testdata_base_path + "bam_fp/bam_fp_test.interval_list", checkIfExists: true)])

                input[6] = Channel.of([[id: "dbsnp"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz",checkIfExists: true)]).first()
                input[7] = Channel.of([[id: "dbsnp"],
                    file(params.modules_testdata_base_path + "genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi",checkIfExists: true)]).first()

                """
            }
        }
        then{
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    workflow.out.vcf,
                    // Only assert name, md5sum is for an empty file.
                    workflow.out.tbi.collect { file(it[1]).name },
                 ).match() }
            )
        }
        cleanup {
            nfcoreUnlink("${launchDir}/library/", "${baseDir}/modules/")
        }
    }
}
