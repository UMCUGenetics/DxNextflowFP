nextflow_workflow {

    name "Test Subworkflow BAM_FP"
    script "../main.nf"
    config "./nextflow.config"
    workflow "BAM_FP"

    tag "subworkflows"
    tag "subworkflows_UMCUGenetics"
    tag "subworkflows/bam_fp"
    tag "local"
    tag "gatk4"
    tag "gatk4/haplotypecaller"
    tag "gatk4/genotypegvcfs"
    tag "subworkflows/../../modules/nf-core/gatk4/haplotypecaller"
    tag "subworkflows/../../modules/nf-core/gatk4/genotypegvcfs"


    setup{
        nfcoreInitialise("${launchDir}/library/")
        nfcoreInstall(
            "${launchDir}/library/",
            [
                "gatk4/haplotypecaller",
                "gatk4/genotypegvcfs"
            ]
        )
        nfcoreLink("${launchDir}/library/", "${baseDir}/modules/")
    }


    test("Validate fingerprint subworkflow - bam") {
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of( [
                    [ id:'sample1' ], // meta map
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam",
                        checkIfExists: true)
                ])
                input[1] = Channel.of( [
                    [ id:'sample1' ], // meta map
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai",
                        checkIfExists: true)
                ])
                input[2] = Channel.of([[id: "genome_fa"],
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/homo_sapiens/genome/genome.fasta", checkIfExists: true)]).first()
                input[3] = Channel.of([[id: "genome_fai"],
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai", checkIfExists: true)]).first()
                input[4] = Channel.of([[id: "genome_dict"],
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/homo_sapiens/genome/genome.dict", checkIfExists: true)]).first()
                input[5] = Channel.of([[id: "intervals"],
                    file(params.subworkflows_umcu_testdata_base_path + "bam_fp/bam_fp_test.interval_list", checkIfExists: true)])

                input[6] = Channel.of([[id: "dbsnp"],
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz",checkIfExists: true)]).first()
                input[7] = Channel.of([[id: "dbsnp"],
                    file("https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/modules/data/genomics/homo_sapiens/genome/vcf/dbsnp_146.hg38.vcf.gz.tbi",checkIfExists: true)]).first()

                """
            }
        }
        then{
            assertAll(
                { assert workflow.success }
            )
        }
        cleanup {
            nfcoreUnlink("${launchDir}/library/", "${baseDir}/modules/")
        }
    }
}
