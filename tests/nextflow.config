/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/dxnextflowfp/'
    standalone_path = "/Users/svriend3/projects/fingerprint/dataset/reference/filt_ref/"

    input = "/Users/svriend3/projects/fingerprint/dataset/reads/samplesheet.csv"
    genome_fasta = "${params.standalone_path}/filt_GCA_000001405.15_GRCh38_no_alt_analysis_set.fna"
    genome_dict = "${params.standalone_path}/filt_GCA_000001405.15_GRCh38_no_alt_analysis_set.dict"
    bwa_index = "${params.standalone_path}/bwa-mem2/"
    intervals = "${params.standalone_path}/filt_nimagen_hg38_edit.interval_list"

    dbsnp = "/Users/svriend3/projects/fingerprint/dataset/gatk_resource/hg38-v0-gdc-dbsnp_144.hg38.vcf.gz"
    output_file_prefix = "test"
    val_umi_dedup = true
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
